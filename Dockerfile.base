# 基础镜像
# docker build -f Dockerfile.base -t actors315/go:acme .

FROM debian:bookworm-slim

LABEL maintainer="actors315 <actors315@gmail.com>"

# acme.sh 运行依赖：
#   curl            —— acme.sh 的 HTTP/HTTPS 请求（--upgrade 下载、--issue、DNS API 调用）
#   openssl         —— 账户密钥 / CSR 生成
#   ca-certificates —— HTTPS 根证书（acme.sh 与 cert-monitor 调腾讯云 API 都依赖）
# sh / tar / gzip / sed / awk / env 等工具 debian 基础镜像自带，无需安装
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl openssl \
    && rm -rf /var/lib/apt/lists/*

# 安装 acme.sh 到 /root/.acme.sh
# --nocron：容器为跑完即退出的 CronJob，续期由 cert-monitor 每次调度时主动调用，不需要系统 cron
RUN curl -fsSL -o /tmp/acme.sh.tar.gz https://github.com/acmesh-official/acme.sh/archive/master.tar.gz \
    && tar -xzf /tmp/acme.sh.tar.gz -C /tmp \
    && cd /tmp/acme.sh-master \
    && ./acme.sh --install --nocron \
    && rm -rf /tmp/*

# cert-monitor 运行目录
RUN mkdir -p /usr/local/qcloud-tools/shell /usr/local/qcloud-tools/config

CMD ["/bin/bash"]
